# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env

# project secrets and generated files — never commit these
data/config.txt
data/*.pkl
logs/
__pycache__/
*.pyc

# the trained model IS committed — CI loads it instead of retraining daily
!data/mlb_model.pkl

npm-debug.log*
yarn-debug.log*
yarn-error.log*
